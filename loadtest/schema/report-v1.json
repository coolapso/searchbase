{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Searchbase core load report v1",
  "type": "object",
  "required": ["schema_version", "run_id", "suite", "scenario", "profile", "comparable", "instance_label", "started_at", "finished_at", "detected_cpus", "detected_memory_bytes", "phases", "throughput", "latency", "errors", "samples", "last_stable_rate", "safe_capacity"],
  "properties": {
    "schema_version": {"const": "searchbase-load-report/v1"},
    "run_id": {"type": "string"},
    "suite": {"type": "string"},
    "scenario": {"type": "string"},
    "mode": {"type": "string"},
    "payload": {"type": "string"},
    "js_render": {"type": "boolean"},
    "operations": {"type": "array"},
    "payload_classes": {"type": "array", "items": {"type": "string"}},
    "profile": {"enum": ["smoke", "discover", "soak"]},
    "comparable": {"type": "boolean"},
    "instance_label": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "git_revision": {"type": "string"},
    "detected_cpus": {"type": "integer", "minimum": 0},
    "detected_memory_bytes": {"type": "integer", "minimum": 0},
    "phases": {"type": "array"},
    "throughput": {"type": "number", "minimum": 0},
    "latency": {"type": "object", "required": ["count", "p50_ms", "p95_ms", "p99_ms"]},
    "latency_histogram": {"type": "array"},
    "errors": {"type": "object"},
    "samples": {"type": "array"},
    "saturation_reason": {"type": "string"},
    "last_stable_rate": {"type": "number", "minimum": 0},
    "safe_capacity": {"type": "number", "minimum": 0},
    "resource_per_successful_operation": {"type": "object"},
    "invalid_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
